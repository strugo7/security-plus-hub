# Agent System Configuration

# Path to watch for file changes
WATCH_PATH=../src

# Retry limit for LLM self-correction attempts
MAX_RETRIES=3

# Debounce interval in milliseconds
DEBOUNCE_MS=500

# Severity thresholds (comma-separated severities that trigger blocking)
BLOCK_SEVERITIES=Critical,High

# Health endpoint port
HEALTH_PORT=4200

# Agent reports output directory
REPORTS_DIR=./agent-reports

# Review required log file
REVIEW_LOG=./review-required.log

# Log level (trace, debug, info, warn, error, fatal)
LOG_LEVEL=info
